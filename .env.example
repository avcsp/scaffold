# Application
ENV=dev
PORT=8080

# Database (optional — remove or leave empty to skip)
# Postgres: DATABASE_DSN=host=localhost port=5432 user=postgres password=secret dbname=app sslmode=disable
# MariaDB/MySQL: DATABASE_DSN=mariadb://root:secret@localhost:3306/app?charset=utf8mb4&parseTime=True&loc=Local

# CORS (optional — defaults shown)
# CORS_ORIGINS=*
# CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_HEADERS=Content-Type,Authorization
# CORS_MAX_AGE=86400
